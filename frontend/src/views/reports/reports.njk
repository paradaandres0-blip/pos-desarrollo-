{% extends "layout.njk" %}

{% block content %}
<h1>Reportes</h1>

{% if error %}
  <div class="alert alert-error">{{ error }}</div>
{% endif %}

<div class="card">
  <h2>Filtros de Fecha</h2>
  <form method="GET" action="/reports">
    <div class="form-row">
      <div class="form-group">
        <label for="from">Desde</label>
        <input type="date" id="from" name="from" value="{{ from }}">
      </div>
      <div class="form-group">
        <label for="to">Hasta</label>
        <input type="date" id="to" name="to" value="{{ to }}">
      </div>
      <div class="form-group" style="align-self:flex-end;">
        <button type="submit" class="btn btn-primary">Consultar</button>
      </div>
    </div>
  </form>
</div>

{% if salesReport %}
<div class="card">
  <h2>Reporte de Ventas</h2>
  <table>
    <thead>
      <tr>
        <th>Total Ventas</th>
        <th>Monto Recaudado</th>
        <th>Efectivo</th>
        <th>Tarjeta Credito</th>
        <th>Tarjeta Debito</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>{{ salesReport.totalSales or 0 }}</td>
        <td>${{ salesReport.totalAmount or '0.00' }}</td>
        <td>${{ (salesReport.byMethod.CASH if salesReport.byMethod and salesReport.byMethod.CASH) or '0.00' }}</td>
        <td>${{ (salesReport.byMethod.CREDIT_CARD if salesReport.byMethod and salesReport.byMethod.CREDIT_CARD) or '0.00' }}</td>
        <td>${{ (salesReport.byMethod.DEBIT_CARD if salesReport.byMethod and salesReport.byMethod.DEBIT_CARD) or '0.00' }}</td>
      </tr>
    </tbody>
  </table>
</div>
{% endif %}

{% if topProducts %}
<div class="card">
  <h2>Top 10 Productos Mas Vendidos</h2>
  <table>
    <thead>
      <tr>
        <th>#</th>
        <th>Producto</th>
        <th>Codigo</th>
        <th>Cantidad Vendida</th>
      </tr>
    </thead>
    <tbody>
      {% if topProducts.length > 0 %}
        {% for item in topProducts %}
          <tr>
            <td>{{ loop.index }}</td>
            <td>{{ item.productName or item.name }}</td>
            <td>{{ item.productCode or item.code }}</td>
            <td>{{ item.totalQuantity or item.quantity or 0 }}</td>
          </tr>
        {% endfor %}
      {% else %}
        <tr><td colspan="4" style="text-align:center;color:#999;">Sin datos para el periodo.</td></tr>
      {% endif %}
    </tbody>
  </table>
</div>
{% endif %}

<div class="card">
  <h2>Reporte de Inventario</h2>
  <table>
    <thead>
      <tr>
        <th>Codigo</th>
        <th>Nombre</th>
        <th>Precio</th>
        <th>Stock</th>
        <th>Estado</th>
      </tr>
    </thead>
    <tbody>
      {% if inventoryReport and inventoryReport.length > 0 %}
        {% for product in inventoryReport %}
          <tr class="{% if product.outOfStock %}out-of-stock{% elif product.lowStock %}low-stock{% endif %}">
            <td>{{ product.code }}</td>
            <td>{{ product.name }}</td>
            <td>${{ product.price }}</td>
            <td>{{ product.stockLevel }}</td>
            <td>
              {% if product.outOfStock %}
                <span class="badge badge-danger">Sin stock</span>
              {% elif product.lowStock %}
                <span class="badge badge-warning">Stock bajo</span>
              {% else %}
                <span class="badge badge-ok">OK</span>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      {% else %}
        <tr><td colspan="5" style="text-align:center;color:#999;">Sin datos de inventario.</td></tr>
      {% endif %}
    </tbody>
  </table>
</div>
{% endblock %}
